# Google Gemini API Key (required for NL query answering)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model name
GEMINI_MODEL=gemini-2.5-flash

# Paths (relative to project root, not backend/)
DB_PATH=../tickets.db
CSV_PATH=../data/support_tickets.csv

# Uvicorn server
API_HOST=127.0.0.1
API_PORT=8000
